# Copy to .env and fill in. NEVER commit the real .env file.
# Generate PAPER keys from the Alpaca dashboard (https://app.alpaca.markets).
APCA_API_KEY_ID=your_paper_key_id
APCA_API_SECRET_KEY=your_paper_secret
# paper | live  (keep paper until the strategy has proven itself for weeks)
BOT_MODE=paper
# Optional: override the default watchlist
# BOT_WATCHLIST=AAPL,MSFT,GOOGL,AMZN,NVDA
